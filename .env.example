# Required for a production GitHub Pages build. Do not include a trailing slash.
VITE_API_BASE_URL=https://api.example.org

# The Pages workflow derives this automatically. Set it only for a local
# production-build check: /REPOSITORY_NAME/ for a project site, or / at root.
VITE_BASE_PATH=/

# Public frontend URL used for link-preview images (never the API URL).
# The Pages workflow derives it automatically; set it for a custom domain.
VITE_SITE_URL=https://alexander-mitrofanov.github.io/crispr-evolution-web/
